--- a/bin/omarchy-pkg-aur-add
+++ b/bin/omarchy-pkg-aur-add
@@ -3,13 +3,28 @@
 # omarchy:summary=Add the named packages to the system from the AUR if they're missing. Returns false if it couldn't be done.
 # omarchy:args=<packages...>
 
+# Try Omarchy: refuse known aarch64-unavailable Install-menu packages.
+if [[ -x /usr/local/bin/omarchy-pkg-refuse-aarch64-unavailable ]]; then
+  /usr/local/bin/omarchy-pkg-refuse-aarch64-unavailable "$@" || exit $?
+fi
+
+# Try Omarchy: names that exist only in the sync-only aarch64 repositories
+# ([omarchy] edge, [omarchy-aarch64]) are rewritten to explicit repo/name
+# targets; everything else passes through unchanged.
+targets=("$@")
+if [[ -x /usr/local/bin/omarchy-pkg-resolve-aarch64-sources ]]; then
+  mapfile -t targets < <(/usr/local/bin/omarchy-pkg-resolve-aarch64-sources "$@")
+  (( ${#targets[@]} > 0 )) || targets=("$@")
+fi
+
 if omarchy-pkg-missing "$@"; then
-  yay -S --noconfirm --needed "$@" || exit 1
+  yay -S --noconfirm --needed "${targets[@]}" || exit 1
 fi
 
 for pkg in "$@"; do
   # Secondary check to handle states where pacman doesn't actually register an error
-  if ! pacman -Q "$pkg" &>/dev/null; then
+  # pacman -T also accepts a provider (obsidian-appimage provides obsidian).
+  if ! pacman -Q "$pkg" &>/dev/null && ! pacman -T "$pkg" &>/dev/null; then
     echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
     exit 1
   fi
