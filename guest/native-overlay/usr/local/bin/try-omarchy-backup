#!/bin/bash
# omarchy:summary=Save your added packages and home directory so a fresh Try Omarchy VM can restore them
# omarchy:args=[--home-only|--packages-only] [DESTINATION_DIR]
#
# Try Omarchy creates a new VM for every new guest image, so anything you set
# up lives only in that VM. This writes what a fresh VM needs to carry on:
#   packages.txt  explicitly installed packages beyond the factory image
#   home.tar.zst  your home directory without caches
#   manifest.json when and where the backup was taken
# The default destination is the shared Mac folder (/mnt/mac), so the backup
# is on the Mac and outlives the VM. Restore with try-omarchy-restore.
set -euo pipefail

usage() {
  sed -n '2,3p' "$0" | sed 's/^# omarchy:[a-z]*=//'
  echo "Default destination: /mnt/mac/try-omarchy-backup (requires the shared Mac folder)"
}
fail() { echo "try-omarchy-backup: $*" >&2; exit 1; }

mode=all
destination=""
while (($#)); do
  case "$1" in
    --home-only) mode=home ;;
    --packages-only) mode=packages ;;
    -h|--help) usage; exit 0 ;;
    -*) fail "unknown option: $1" ;;
    *) [[ -z $destination ]] || fail "only one destination directory is accepted"; destination=$1 ;;
  esac
  shift
done

if [[ -z $destination ]]; then
  mountpoint -q /mnt/mac || fail "the shared Mac folder is not mounted; enable it in the Try Omarchy start menu or pass a destination directory"
  destination=/mnt/mac/try-omarchy-backup
fi
mkdir -p "$destination" || fail "cannot create $destination"
destination=$(cd "$destination" && pwd -P)

factory_list=/usr/share/try-omarchy/packages.lock.txt
[[ -r $factory_list ]] || fail "factory package list not found: $factory_list"

if [[ $mode != home ]]; then
  # Explicitly installed packages that the factory image did not ship. Both
  # repository and AUR packages are listed; the restore decides how to get each.
  comm -23 \
    <(pacman -Qqe | LC_ALL=C sort) \
    <(awk '{ print $1 }' "$factory_list" | LC_ALL=C sort) \
    >"$destination/packages.txt"
  printf 'Saved %s added package(s) to %s\n' "$(wc -l <"$destination/packages.txt" | tr -d ' ')" "$destination/packages.txt"
fi

if [[ $mode != packages ]]; then
  # Caches are rebuilt on use; Trash is noise; the Mac share link points at the
  # destination itself. Symlinks are stored as symlinks, never followed.
  tar --zstd -cf "$destination/home.tar.zst" -C "$HOME" \
    --exclude=./.cache \
    --exclude=./.local/share/Trash \
    --exclude=./.npm/_cacache \
    --exclude=./.cargo/registry \
    --exclude=./.local/share/containers \
    --exclude-caches-all \
    . || fail "home directory archive failed"
  printf 'Saved home directory (%s) to %s\n' "$(du -h "$destination/home.tar.zst" | cut -f1)" "$destination/home.tar.zst"
fi

# Lerd databases: each registered site's database, exported with Lerd's own
# tooling from the site directory (db:export defaults to that site's database).
# Podman volumes themselves are deliberately not archived; the SQL dumps are
# what try-omarchy-restore feeds back through db:import.
lerd_registry="$HOME/.local/share/lerd/sites.yaml"
if [[ $mode != packages ]] && command -v lerd >/dev/null 2>&1 && [[ -r $lerd_registry ]]; then
  lerd_dir="$destination/lerd-databases"
  mkdir -p "$lerd_dir"
  : >"$lerd_dir/index.tsv"
  lerd_exported=0
  lerd_skipped=0
  while IFS=$'\t' read -r site_name site_path; do
    [[ -n $site_name && -d $site_path ]] || { lerd_skipped=$((lerd_skipped + 1)); continue; }
    dump="$lerd_dir/${site_name//\//_}.sql"
    if (cd "$site_path" && lerd db:export --no-pull -o "$dump" >/dev/null 2>&1) && [[ -s $dump ]]; then
      printf '%s\t%s\n' "$site_name" "$site_path" >>"$lerd_dir/index.tsv"
      lerd_exported=$((lerd_exported + 1))
    else
      rm -f -- "$dump"
      lerd_skipped=$((lerd_skipped + 1))
    fi
  done < <(python3 - "$lerd_registry" <<'PY'
import sys
import yaml

registry = yaml.safe_load(open(sys.argv[1])) or {}
for site in registry.get("sites") or []:
    if isinstance(site, dict) and site.get("name") and site.get("path"):
        print(f"{site['name']}\t{site['path']}")
PY
)
  printf 'Lerd: exported %d site database(s) to %s (%d site(s) without an exportable database)\n' \
    "$lerd_exported" "$lerd_dir" "$lerd_skipped"
fi

python3 - "$destination/manifest.json" "$mode" <<'PY'
import datetime, json, os, socket, subprocess, sys
runtime = subprocess.run(["pacman", "-Q", "try-omarchy-runtime"], capture_output=True, text=True).stdout.strip()
json.dump({
    "schemaVersion": 1,
    "createdAt": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
    "hostname": socket.gethostname(),
    "user": os.environ.get("USER", ""),
    "tryOmarchyRuntime": runtime,
    "mode": sys.argv[2],
}, open(sys.argv[1], "w"), indent=2)
PY
echo "Backup complete. In a fresh VM run: try-omarchy-restore${destination:+ $destination}"
