#!/bin/bash
# omarchy:summary=Rewrite package names to explicit aarch64 sources on Try Omarchy
# omarchy:args=<packages...>
# omarchy:hidden=true
#
# Prints one pacman target per line. A name the enabled repositories carry stays
# bare. A name that exists only in a sync-only repository is rewritten to
# repo/name: [omarchy] (Omarchy edge, signed) first, then [omarchy-aarch64]
# (omarchy-mac builds, unsigned, opt-in), pulling in same-repo dependencies the
# enabled repositories lack. Explicit aliases live in the map file below.
set -euo pipefail

if [[ $(uname -m) != aarch64 ]]; then
  printf '%s\n' "$@"
  exit 0
fi

map=/usr/local/share/try-omarchy/aarch64-package-sources
sync_root=/var/lib/pacman/sync

# Sync-only repositories are refreshed by -Sy like any other, but a fresh guest
# may not have synced yet. Fetch the databases once so lookups can succeed.
for repo in omarchy omarchy-aarch64; do
  if [[ ! -f $sync_root/$repo.db ]]; then
    if (( EUID == 0 )); then
      pacman -Sy --noconfirm >/dev/null 2>&1 || true
    else
      sudo pacman -Sy --noconfirm >/dev/null 2>&1 || true
    fi
    break
  fi
done

# `pacman -Si` finds a package in a Usage = Sync repository even by bare name,
# so it cannot tell whether a bare name is installable. `-Sp` honours the usage
# restriction the way `-S` does, so probe installability with it (dependency
# checks off: only the target's existence matters here). Explicit repo/name
# lookups and dependency reads can use -Si.
installable() {
  pacman -Sp -dd --print-format '%n' "$1" >/dev/null 2>&1
}

in_repo_lookup() {
  pacman -Si "$1" >/dev/null 2>&1
}

declare -A seen=()
add_target() {
  # Written as an if-block on purpose: under `set -e`, a failing `[[ ]] && ...`
  # as the last command makes the function return 1 and aborts the script.
  if [[ -n ${seen[$1]:-} ]]; then
    return 0
  fi
  seen[$1]=1
  printf '%s\n' "$1"
}

depends_of() {
  pacman -Si "$1" 2>/dev/null |
    awk -F ': *' '/^Depends On/ { print $2 }' |
    tr ' ' '\n' |
    sed -E 's/[<>=].*$//' |
    grep -vE '^(None)?$' || true
}

# An explicit repo/name target, plus the dependencies only that repo provides.
resolve_target() {
  local target=$1 repo=${1%%/*} dep
  add_target "$target"
  [[ $target == */* ]] || return 0
  while IFS= read -r dep; do
    [[ -n $dep ]] || continue
    if ! installable "$dep" && in_repo_lookup "$repo/$dep"; then
      resolve_target "$repo/$dep"
    fi
  done < <(depends_of "$target")
}

resolve() {
  local pkg=$1 alias target
  alias=$(awk -F '\t' -v p="$pkg" '$1 == p { print $2; exit }' "$map" 2>/dev/null || true)
  if [[ -n $alias ]]; then
    for target in $alias; do
      resolve_target "$target"
    done
    return 0
  fi
  if installable "$pkg"; then
    add_target "$pkg"
  elif in_repo_lookup "omarchy/$pkg"; then
    add_target "omarchy/$pkg"
  elif in_repo_lookup "omarchy-aarch64/$pkg"; then
    resolve_target "omarchy-aarch64/$pkg"
  else
    add_target "$pkg"
  fi
}

for pkg in "$@"; do
  [[ -n $pkg ]] || continue
  resolve "$pkg"
done
