#!/bin/bash
# omarchy:summary=Rebuild a .pkg.tar.zst for an installed package from its installed files and pacman's local database
# omarchy:args=[-o OUTDIR] PACKAGE...
#
# A bacman replacement (pacman-contrib dropped bacman). Used by
# try-omarchy --backup when no built file for a foreign package exists in
# yay's cache or the Work folders, so the rebuild can `pacman -U` the file
# instead of compiling the package again. Metadata comes from
# /var/lib/pacman/local/<name>-<version>/{desc,files,mtree,install,changelog};
# file contents come from the live filesystem, so run `pacman -Qkk PACKAGE`
# first if you need to be sure nothing was modified after installation.
set -euo pipefail

fail() { echo "try-omarchy --repack: $*" >&2; exit 1; }
outdir=$PWD
while (($#)); do
  case "$1" in
    -o) [[ -n ${2:-} ]] || fail "-o needs a directory"; outdir=$2; shift 2 ;;
    -h|--help) sed -n 's/^# omarchy:summary=//p' "$0"; echo; sed -n 's/^# omarchy:args=/  try-omarchy --repack /p' "$0"; exit 0 ;;
    -*) fail "unknown option: $1" ;;
    *) break ;;
  esac
done
(($#)) || fail "no package given"
mkdir -p "$outdir" || fail "cannot create $outdir"
outdir=$(cd "$outdir" && pwd -P)
for tool in bsdtar zstd python3; do command -v "$tool" >/dev/null || fail "$tool is required"; done

status=0
for pkg in "$@"; do
  ver=$(pacman -Q "$pkg" 2>/dev/null | awk '{ print $2 }')
  [[ -n $ver ]] || { echo "try-omarchy --repack: $pkg is not installed" >&2; status=1; continue; }
  db=/var/lib/pacman/local/$pkg-$ver
  [[ -r $db/desc && -r $db/files && -r $db/mtree ]] || { echo "try-omarchy --repack: incomplete database entry $db" >&2; status=1; continue; }
  arch=$(awk '/^%ARCH%/ { getline; print; exit }' "$db/desc")
  out="$outdir/$pkg-$ver-$arch.pkg.tar.zst"
  tmp=$(mktemp -d)

  # .PKGINFO in makepkg's format, from the desc and files entries.
  python3 - "$db" "$tmp/.PKGINFO" <<'PY'
import re, sys
db, out = sys.argv[1], sys.argv[2]
def parse(path):
    section, data = None, {}
    for line in open(path, encoding="utf-8", errors="replace"):
        line = line.rstrip("\n")
        m = re.fullmatch(r"%([A-Z_]+)%", line)
        if m:
            section = m.group(1); data[section] = []
        elif section and line:
            data[section].append(line)
    return data
desc, files = parse(f"{db}/desc"), parse(f"{db}/files")
one = lambda key: (desc.get(key) or [""])[0]
lines = [
    "# Generated by try-omarchy --repack from the pacman local database",
    "pkgname = " + one("NAME"),
    "pkgbase = " + (one("BASE") or one("NAME")),
    "pkgver = " + one("VERSION"),
    "pkgdesc = " + one("DESC"),
    "url = " + one("URL"),
    "builddate = " + one("BUILDDATE"),
    "packager = " + one("PACKAGER"),
    "size = " + one("SIZE"),
    "arch = " + one("ARCH"),
]
for key, section in [("license", "LICENSE"), ("group", "GROUPS"), ("replaces", "REPLACES"),
                     ("conflict", "CONFLICTS"), ("provides", "PROVIDES"), ("depend", "DEPENDS"),
                     ("optdepend", "OPTDEPENDS"), ("makedepend", "MAKEDEPENDS"),
                     ("checkdepend", "CHECKDEPENDS"), ("xdata", "XDATA")]:
    lines += [f"{key} = {value}" for value in desc.get(section, [])]
lines += ["backup = " + entry.split("\t")[0] for entry in files.get("BACKUP", [])]
open(out, "w").write("\n".join(lines) + "\n")
PY
  cp "$db/mtree" "$tmp/.MTREE"
  meta=(.PKGINFO .MTREE)
  [[ -f $db/install ]] && { cp "$db/install" "$tmp/.INSTALL"; meta+=(.INSTALL); }
  [[ -f $db/changelog ]] && { cp "$db/changelog" "$tmp/.CHANGELOG"; meta+=(.CHANGELOG); }
  # Metadata first (as makepkg writes it), then every recorded path from /,
  # without recursion so directories are stored as the single entries listed.
  # bsdtar only honours -C/-T before the first path, so the list file carries
  # its own -C lines (a "-C" line followed by the directory).
  {
    printf -- '-C\n%s\n' "$tmp"; printf '%s\n' "${meta[@]}"
    printf -- '-C\n/\n'
    awk '/^%FILES%/ { f = 1; next } /^%/ { f = 0 } f && NF' "$db/files"
  } >"$tmp/list"
  if LANG=C bsdtar --no-fflags -cnf - -T "$tmp/list" 2>"$tmp/err" \
       | zstd -q -T0 -12 -f -o "$out"; then
    if [[ -s $tmp/err ]]; then
      echo "try-omarchy --repack: $pkg: bsdtar warnings:" >&2; cat "$tmp/err" >&2
    fi
    echo "$out"
  else
    echo "try-omarchy --repack: $pkg: bsdtar failed:" >&2; cat "$tmp/err" >&2
    rm -f "$out"; status=1
  fi
  rm -rf "$tmp"
done
exit $status
